# Copy to `.env` on the machine. Never commit `.env`.
# No cloud keys. Values below are not secrets except WEBUI_SECRET_KEY.

# Published on 127.0.0.1 only (see compose.yaml).
OLLAMA_HOST_PORT=11434
OPEN_WEBUI_HOST_PORT=3000
SERVER_HOST_PORT=8080

# Image tags. Pin these when you want a frozen pair.
OLLAMA_DOCKER_TAG=latest
WEBUI_DOCKER_TAG=main

# First model listed in models/LICENSES.md
OLLAMA_MODEL=mistral
# Pulled separately: it builds the retrieval vectors, it does not answer.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Gateway. Clients ask for an alias; the alias resolves here, so a better model replaces the
# current one without touching any client. `alias=model` pairs, or JSON in this file.
MODEL_ALIASES=cabinet-chat=mistral,cabinet-rapide=mistral,cabinet-embed=nomic-embed-text
DEFAULT_MODEL_ALIAS=cabinet-chat
# Changing this means re-indexing: vectors from two models cannot be compared.
DEFAULT_EMBEDDING_ALIAS=cabinet-embed

# Language of the answer when a request arrives without one. Never silently English.
DEFAULT_OUTPUT_LOCALE=fr-FR

# Longest answer the gateway will let a model produce, in tokens, whether or not the caller asked
# for a limit. Around 6 500 French characters: generous for a summary of a specialist report, and
# short enough that a model falling into a repetition loop stops in about a minute instead of
# writing until a client gives up. Raise it only for a genuinely long document.
MAX_OUTPUT_TOKENS=2048

# Hidden reasoning. Some models (the qwen3 family, gemma4 on a long prompt) write a reasoning before
# the answer. It is never shown, but it takes time and counts against MAX_OUTPUT_TOKENS, so a model
# can spend the whole budget thinking and return nothing. `default` leaves the model alone (today's
# behaviour); `off` asks the runtime not to think. It only matters for models that think; every model
# accepts `off`. There is no `on`: a model that cannot think refuses the request.
LLM_THINK=default

# How long Ollama keeps a model in memory after the last question. Its own default is 5 minutes, and
# loading a model takes 36 to 210 s on the development PC, so the first question after a quiet moment
# waits that long. A duration (30m, 2h), or -1 to keep the model loaded until the container stops:
# use -1 on the Mac mini, which has the memory for it.
OLLAMA_KEEP_ALIVE=30m

# The longest silence the gateway accepts from the model, in seconds: before the first word (the
# runtime loading the model and reading the prompt) and between two chunks. On a CPU-only server the
# first request after switching models can stay silent longer than the default; raise it there (for
# example 600). Set it very low (for example 5) only to check that the desktop explains a timeout.
LLM_REQUEST_TIMEOUT_SECONDS=180

# How much one request may hold, in tokens: the instruction, the excerpts, the conversation's
# memory and the answer together. Sent to the runtime on every request and capped at what the
# model supports. Larger means a longer memory, but a slower answer and more memory used on the
# server device: measure with apps/server/scripts/measure_context.py before raising it.
DEFAULT_CONTEXT_WINDOW=8192
# Per-alias exceptions, as alias=tokens pairs. Empty means every alias uses the default.
MODEL_CONTEXT_WINDOWS=

# Sent by Open WebUI to the gateway. The gateway does not check keys yet: per-person keys are
# sprint 4. Not a secret today, and not a reason to invent one.
GATEWAY_API_KEY=local-owner-key

# true = first account can be created in the UI (that user is admin).
# Set to false after the admin account exists.
ENABLE_SIGNUP=true

# Compose is the source of truth for Open WebUI flags (see compose.yaml).
ENABLE_PERSISTENT_CONFIG=false

# Chat behaviour (admin drafting). Open WebUI UI is English. Follow-ups and auto-tags off.
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_TAGS_GENERATION=false

# Long random string. Sessions reset if this changes.
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
