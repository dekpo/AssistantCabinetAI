# Copy to `.env` on the machine. Never commit `.env`.
# No cloud keys. Values below are not secrets except WEBUI_SECRET_KEY.

# Published on 127.0.0.1 only (see compose.yaml).
OLLAMA_HOST_PORT=11434
OPEN_WEBUI_HOST_PORT=3000

# Image tags. Pin these when you want a frozen pair.
OLLAMA_DOCKER_TAG=latest
WEBUI_DOCKER_TAG=main

# First model listed in models/LICENSES.md
OLLAMA_MODEL=mistral

# true = first account can be created in the UI (that user is admin).
# Set to false after the admin account exists.
ENABLE_SIGNUP=true

# Long random string. Sessions reset if this changes.
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
