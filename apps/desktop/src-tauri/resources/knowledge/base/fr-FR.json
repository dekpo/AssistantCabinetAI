    { "id": "recipient", "label_key": "knowledge.roles.recipient" },
    { "id": "author", "label_key": "knowledge.roles.author" },
    { "id": "supplier", "label_key": "knowledge.roles.supplier" }
  ],
  "detection_terms": []
}
