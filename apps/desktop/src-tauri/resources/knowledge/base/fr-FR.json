{
  "schema": 1,
  "id": "base",
  "locale": "fr-FR",
  "titles": {
    "person": ["Dr", "Docteur", "Pr", "Professeur", "Prof", "Maître", "Monsieur", "Mr", "Mme", "Madame", "Mlle", "Mademoiselle"]
  },
  "weak_titles": ["Me", "M"],
  "particles": ["de", "du", "des", "la", "le", "van", "von", "der", "den", "di", "da", "dos", "das", "el", "al"],
  "title_spoken": {
    "dr": "docteur",
    "pr": "professeur",
    "prof": "professeur",
    "m": "monsieur",
    "mr": "monsieur",
    "mme": "madame",
    "mlle": "mademoiselle",
    "me": "maître"
  },
  "stop_words": [
    "janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre",
    "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche",
    "facture", "devis", "commande", "bon", "avoir", "relevé", "courrier", "lettre", "mail", "note",
    "scan", "copie", "original", "brouillon", "version", "final", "modèle", "annexe", "pièce", "rapport",
    "compte", "rendu", "contrat", "attestation", "certificat", "tableau", "liste", "total",
    "nul", "null", "none", "néant", "inconnu", "n/a", "na", "vide", "oui", "non"
  ],
  "org_markers": {
    "prefix": ["association", "cabinet", "société", "entreprise", "groupe", "fondation", "syndicat", "mairie", "ville de"],
    "suffix": ["SA", "SARL", "SAS", "SASU", "EURL", "SCI", "SNC", "SCP", "SCM", "SELARL"]
  },
  "identifier_schemes": [
    {
      "id": "email",
      "kind": "email",
      "regex": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9\\-]+(?:\\.[A-Za-z0-9\\-]+)*\\.[A-Za-z]{2,}",
      "normalise": "alnum",
      "strength": "exact",
      "personal_key": true
    },
    {
      "id": "phone",
      "kind": "phone",
      "regex": "(?:\\+33|0033|0)[\\s.\\-]?[1-9](?:[\\s.\\-]?\\d{2}){4}",
      "normalise": "digits",
      "strength": "possible",
      "personal_key": false
    },
    {
      "id": "iban",
      "kind": "iban",
      "regex": "\\bFR\\d{2}(?:\\s?[A-Z0-9]{4}){5}\\s?[A-Z0-9]{3}\\b",
      "normalise": "alnum",
      "strength": "exact",
      "personal_key": true
    },
    {
      "id": "invoice_number",
      "kind": "invoice",
      "regex": "\\b[A-Z]{2,4}-\\d{4}-\\d{2,6}\\b",
      "normalise": "alnum",
      "strength": "exact",
      "personal_key": false
    },
    {
      "id": "order_number",
      "kind": "order",
      "regex": "\\b(?:CMD|BC|PO)[\\-\\s]?\\d{4,10}\\b",
      "normalise": "alnum",
      "strength": "exact",
      "personal_key": false
    }
  ],
  "columns": [
    { "headers": ["nom", "nom de famille", "patronyme"], "semantic": { "type": "person", "subtype": "family_name" }, "confidence": 0.85 },
    { "headers": ["prénom", "prenoms", "prénoms"], "semantic": { "type": "person", "subtype": "given_name" }, "confidence": 0.85 },
    { "headers": ["nom complet", "nom prénom", "nom et prénom", "identité"], "semantic": { "type": "person" }, "confidence": 0.9 },
    { "headers": ["client", "cliente", "nom du client"], "semantic": { "type": "person", "role": "client" }, "confidence": 0.8 },
    { "headers": ["destinataire"], "semantic": { "type": "person", "role": "recipient" }, "confidence": 0.8 },
    { "headers": ["expéditeur", "émetteur"], "semantic": { "type": "person", "role": "sender" }, "confidence": 0.8 },
    { "headers": ["auteur", "rédacteur"], "semantic": { "type": "person", "role": "author" }, "confidence": 0.8 },
    { "headers": ["fournisseur", "nom du fournisseur"], "semantic": { "type": "organization", "role": "supplier" }, "confidence": 0.85 },
    { "headers": ["société", "entreprise", "organisme", "raison sociale"], "semantic": { "type": "organization" }, "confidence": 0.85 },
    { "headers": ["adresse", "adresse postale", "rue"], "semantic": { "type": "location", "subtype": "address" }, "confidence": 0.85 },
    { "headers": ["ville", "commune"], "semantic": { "type": "location", "subtype": "city" }, "confidence": 0.9 },
    { "headers": ["code postal", "cp"], "semantic": { "type": "location", "subtype": "postal_code" }, "confidence": 0.9 },
    { "headers": ["pays"], "semantic": { "type": "location", "subtype": "country" }, "confidence": 0.9 },
    { "headers": ["email", "e-mail", "courriel", "mail", "adresse mail", "adresse email"], "semantic": { "type": "identifier", "subtype": "email" }, "confidence": 0.95 },
    { "headers": ["téléphone", "tel", "tél", "mobile", "portable", "numéro de téléphone"], "semantic": { "type": "identifier", "subtype": "phone" }, "confidence": 0.9 },
    { "headers": ["numéro de facture", "n° facture", "facture n", "référence facture"], "semantic": { "type": "identifier", "subtype": "invoice" }, "confidence": 0.9 },
    { "headers": ["référence", "réf", "ref", "identifiant", "numéro"], "semantic": { "type": "identifier" }, "confidence": 0.7 },
    { "headers": ["désignation", "libellé", "produit", "article"], "semantic": { "type": "item" }, "confidence": 0.8 }
  ],
  "relations": [
    { "from_role": "client", "to_role": "provider", "predicate": "served_by" },
    { "from_role": "client", "to_role": "supplier", "predicate": "supplied_by" },
    { "from_role": "sender", "to_role": "recipient", "predicate": "sent_to" }
  ],
  "roles": [
    { "id": "client", "label_key": "knowledge.roles.client" },
    { "id": "provider", "label_key": "knowledge.roles.provider" },
    { "id": "counterparty", "label_key": "knowledge.roles.counterparty" },
