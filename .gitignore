# Documentation under docs/ is the versioned English specification.
# Only personal context and tab handoffs stay local.
/docs/private/
/docs/SESSION-*.md
/docs/SESSION-WORKSPACE/
/docs/SESSION-SPEECH/
/docs/SESSION-EXPLORER/
/docs/SESSIONS-DONE/

.env
.env.*
!.env.example
.ollama/
models/*.gguf
*.pem
*.p12
node_modules/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
.vite/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
.DS_Store
Thumbs.db
fixtures/gp-sandbox/real/
*.log
/data/
/backups/

# The Tesseract sidecar, its runtime DLLs, the fra.traineddata model weight, and the pdfium
# library are fetched by scripts/fetch-ocr-resources.ps1, never committed - the same rule that
# keeps Ollama's weights (.ollama/, models/*.gguf) out of git applies here.
apps/desktop/src-tauri/binaries/*.exe
apps/desktop/src-tauri/resources/tesseract/
apps/desktop/src-tauri/resources/tessdata/
apps/desktop/src-tauri/resources/pdfium/

apps/desktop/src-tauri/tesseract*.exe
apps/desktop/src-tauri/*.dll
# Configuration locale de Claude Code / Cline
.claudeignore
.claude/settings.json
.claude/settings.local.json

# The speech worker's native libraries (scripts/fetch-speech-resources.sh), its build output, and the
# staged worker executables. Large reproducible binaries, never committed.
apps/speech-worker/vendor/
apps/speech-worker/target/
apps/speech-worker/target-*/
apps/desktop/src-tauri/binaries/speech-*-worker-*
